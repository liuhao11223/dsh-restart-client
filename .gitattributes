# Normalize text files to LF in the repo regardless of checkout platform.
# index.js embeds '\r\n' line terminators inside string literals for the
# PowerShell helper script, so keep the source itself on LF.
* text=auto eol=lf

*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.svg  text eol=lf
*.ps1  text eol=crlf
