{
  "name": "dsh-restart-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One-click restart for the DSH desktop client: a header corner button, an HTTP endpoint and an agent tool that restart the whole app.",
  "author": "liuhao11223",
  "license": "MIT",
  "homepage": "https://github.com/liuhao11223/dsh-restart-client#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/liuhao11223/dsh-restart-client.git"
  },
  "bugs": {
    "url": "https://github.com/liuhao11223/dsh-restart-client/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "restart",
    "desktop"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}